const fs = require('fs');
const path = require('path');
const bcrypt = require('bcryptjs');
const { db, addAuditLog } = require('./db');

function hashPassword(password) {
  return bcrypt.hashSync(password, 10);
}

function verifyPassword(password, hash) {
  return bcrypt.compareSync(password, hash);
}

function createAdminSession(req, admin) {
  req.session.regenerate((err) => {
    if (err) return;
    req.session.userId = admin.id;
    req.session.email = admin.email;
    req.session.name = admin.name;
    req.session.isAdmin = true;
  });
}

function requireAdmin(req, res, next) {
  if (!req.session || !req.session.isAdmin || !req.session.userId) {
    return res.status(401).json({ error: 'Unauthorized. Admin login required.' });
  }

  const admin = db.prepare('SELECT id, email, name FROM admin_users WHERE id = ?').get(req.session.userId);
  if (!admin) {
    return res.status(401).json({ error: 'Admin session invalid.' });
  }
  req.admin = admin;
  next();
}

function logAction(req, action, targetType, targetId, details) {
  const adminId = req?.admin?.id || req?.session?.userId || null;
  addAuditLog({ adminId, action, targetType, targetId, details });
}

module.exports = { hashPassword, verifyPassword, createAdminSession, requireAdmin, logAction };
